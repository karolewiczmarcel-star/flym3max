    playerListFrame.Size = UDim2.new(0.9, 0, 0.75, 0)
    playerListFrame.Position = UDim2.new(0.05, 0, 0.12, 0)
    playerListFrame.BackgroundColor3 = themes[currentTheme].Dark
    playerListFrame.BorderColor3 = themes[currentTheme].Primary
    playerListFrame.BorderSizePixel = 2
    playerListFrame.ZIndex = 25
    playerListFrame.Visible = false
    playerListFrame.Parent = mainFrame

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 4)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    listLayout.Parent = playerListFrame

    local function refreshPlayerList()
        for _, child in pairs(playerListFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local count = 0
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= plr then
                count = count + 1
                local pBtn = Instance.new("TextButton")
                pBtn.Size = UDim2.new(0.95, 0, 0, 28)
                pBtn.BackgroundColor3 = themes[currentTheme].ButtonBg
                pBtn.BorderColor3 = themes[currentTheme].Primary
                pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                pBtn.Font = Enum.Font.SourceSansBold
                pBtn.TextSize = 14
                pBtn.Text = p.Name
                pBtn.ZIndex = 26
                pBtn.Parent = playerListFrame

                pBtn.MouseButton1Click:Connect(function()
                    targetPlayerName = p.Name
                    b11.Text = "Target: " .. p.Name
                    playerListFrame.Visible = false
                    updateActiveCheatsList()
                end)
            end
        end
        playerListFrame.CanvasSize = UDim2.new(0, 0, 0, count * 32)
    end

    b11.MouseButton1Click:Connect(function()
        playerListFrame.Visible = not playerListFrame.Visible
        if playerListFrame.Visible then refreshPlayerList() end
    end)

    -- Logika suwaków
    local dragging1, dragging2, dragging3, dragging4 = false, false, false, false
    sb1.MouseButton1Down:Connect(function() dragging1 = true end)
    sb2.MouseButton1Down:Connect(function() dragging2 = true end)
    sb3.MouseButton1Down:Connect(function() dragging3 = true end)
    sb4.MouseButton1Down:Connect(function() dragging4 = true end)

    uis.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging1, dragging2, dragging3, dragging4 = false, false, false, false
        end
    end)

    uis.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement then
            if dragging1 then
                local rel = math.clamp((i.Position.X - sb1.AbsolutePosition.X) / sb1.AbsoluteSize.X, 0, 1)
                sf1.Size = UDim2.new(rel, 0, 1, 0)
                flySpeed = math.floor(10 + rel * 290)
                sl1.Text = "Fly Speed: " .. flySpeed
            elseif dragging2 then
                local rel = math.clamp((i.Position.X - sb2.AbsolutePosition.X) / sb2.AbsoluteSize.X, 0, 1)
                sf2.Size = UDim2.new(rel, 0, 1, 0)
                walkSpeedVal = math.floor(16 + rel * 134)
                sl2.Text = "Walk Speed: " .. walkSpeedVal
            elseif dragging3 then
                local rel = math.clamp((i.Position.X - sb3.AbsolutePosition.X) / sb3.AbsoluteSize.X, 0, 1)
                sf3.Size = UDim2.new(rel, 0, 1, 0)
                spinSpeedVal = math.floor(10 + rel * 190)
                sl3.Text = "Spin Speed: " .. spinSpeedVal
            elseif dragging4 then
                local rel = math.clamp((i.Position.X - sb4.AbsolutePosition.X) / sb4.AbsoluteSize.X, 0, 1)
                sf4.Size = UDim2.new(rel, 0, 1, 0)
                farmSpeed = math.floor(5 + rel * 95)
                sl4.Text = "Farm Speed: " .. farmSpeed
            end
        end
    end)

    -- Pętle funkcjonalne MM2
    runService.Stepped:Connect(function()
        if noclip and plr.Character then
            for _, part in pairs(plr.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
        if speedHack and plr.Character and plr.Character:FindFirstChild("Humanoid") then
            plr.Character.Humanoid.WalkSpeed = walkSpeedVal
        end
        if fullbrightEnabled then
            lighting.Brightness = 2
            lighting.ClockTime = 14
            lighting.GlobalShadows = false
        end
    end)

    -- Auto Farm monet (bezpieczne iterowanie)
    task.spawn(function()
        while true do
            task.wait(0.2)
            if autoFarmCoins and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                pcall(function()
                    local hrp = plr.Character.HumanoidRootPart
                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("BasePart") and (v.Name == "Coin_Server" or v.Name == "Coin" or v.Name:lower():find("coin")) then
                            if v.Transparency < 1 then
                                hrp.CFrame = v.CFrame
                                task.wait(0.1)
                                break
                            end
                        end
                    end
                end)
            end
        end
    end)

    uis.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == Enum.KeyCode.P then
            mainFrame.Visible = not mainFrame.Visible
            cheatsPanel.Visible = mainFrame.Visible
        end
    end)
end

-- Start Key System
keyBtn.MouseButton1Click:Connect(function()
    showGameSelector()
end)
