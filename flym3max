-- AUTO TP TO GUN + PAUZA & POWRÓT
------------------------------------------------------------
local originalPos = nil
local isTeleporting = false

b5.MouseButton1Click:Connect(function()
    autoGunTP = not autoGunTP
    b5.Text = autoGunTP and "Auto TP Gun: ON" or "Auto TP Gun: OFF"
    b5.BackgroundColor3 = autoGunTP and Color3.fromRGB(255, 120, 0) or Color3.fromRGB(25, 15, 5)
    
    if not autoGunTP then
        isTeleporting = false
        originalPos = nil
    end
end)

runService.RenderStepped:Connect(function()
    if autoGunTP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = plr.Character.HumanoidRootPart
        local gunDrop = workspace:FindFirstChild("GunDrop", true)

        if gunDrop then
            if not isTeleporting then
                originalPos = hrp.CFrame
                isTeleporting = true
            end
            hrp.CFrame = gunDrop.CFrame + Vector3.new(0, 1, 0)
        else
            if isTeleporting then
                if originalPos then
                    hrp.CFrame = originalPos
                end
                isTeleporting = false
                originalPos = nil
            end
        end
    end
end)

