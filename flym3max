                        playerListFrame.Visible = false
                        updateActiveCheatsList()
                    end)
                end
            end
            playerListFrame.CanvasSize = UDim2.new(0, 0, 0, count * 32)
        end

        local themeListFrame = Instance.new("ScrollingFrame")
        themeListFrame.Size = UDim2.new(0.9, 0, 0.5, 0)
        themeListFrame.Position = UDim2.new(0.05, 0, 0.25, 0)
        themeListFrame.BackgroundColor3 = themes[currentTheme].Dark
        themeListFrame.BorderColor3 = themes[currentTheme].Primary
        themeListFrame.BorderSizePixel = 2
        themeListFrame.ZIndex = 25
        themeListFrame.Visible = false
        themeListFrame.CanvasSize = UDim2.new(0, 0, 0, 220)
        themeListFrame.ScrollBarThickness = 6
        themeListFrame.ScrollBarImageColor3 = themes[currentTheme].Primary
        themeListFrame.Parent = mainFrame

        local themeListLayout = Instance.new("UIListLayout")
        themeListLayout.Padding = UDim.new(0, 6)
        themeListLayout.SortOrder = Enum.SortOrder.LayoutOrder
        themeListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        themeListLayout.Parent = themeListFrame

        local function updateTheme(themeName)
            if not themes[themeName] then return end
            currentTheme = themeName
            bThemeToggle.Text = "Theme: " .. themeName
            
            local t = themes[themeName]
            mainFrame.BackgroundColor3 = t.Dark
            mainFrame.BorderColor3 = t.Primary
            title.BackgroundColor3 = t.Primary
            scrollFrame.ScrollBarImageColor3 = t.Primary
            
            cheatsPanel.BackgroundColor3 = t.Dark
            cheatsPanel.BorderColor3 = t.Primary
            cheatsTitle.BackgroundColor3 = t.Primary
            cheatsScroll.ScrollBarImageColor3 = t.Primary
            
            for _, btn in ipairs(allButtons) do
                btn.BorderColor3 = t.Primary
                if btn.BackgroundColor3 ~= t.Primary and btn ~= bThemeToggle then
                    btn.BackgroundColor3 = t.ButtonBg
                end
            end
            
            for _, sl in ipairs(allSliders) do
                sl.BackgroundColor3 = t.Dark
                sl.BorderColor3 = t.Primary
            end
            
            for _, frm in ipairs(allFrames) do
                frm.BackgroundColor3 = t.Primary
            end
            
            for _, lbl in ipairs(allLabels) do
                lbl.TextColor3 = t.TextCol
            end
            
            playerListFrame.BackgroundColor3 = t.Dark
            playerListFrame.BorderColor3 = t.Primary
            playerListFrame.ScrollBarImageColor3 = t.Primary
            
            themeListFrame.BackgroundColor3 = t.Dark
            themeListFrame.BorderColor3 = t.Primary
            themeListFrame.ScrollBarImageColor3 = t.Primary
            
            updateActiveCheatsList()
        end

        local themeNames = {"Orange", "Red", "Purple", "Yellow", "Blue"}
        for i, tName in ipairs(themeNames) do
            local tBtn = Instance.new("TextButton")
            tBtn.Size = UDim2.new(0.95, 0, 0, 32)
            tBtn.BackgroundColor3 = themes[tName].Primary
            tBtn.BorderColor3 = Color3.fromRGB(255, 255, 255)
            tBtn.BorderSizePixel = 1
            tBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tBtn.Font = Enum.Font.SourceSansBold
            tBtn.TextSize = 14
            tBtn.Text = "Motyw: " .. tName
            tBtn.ZIndex = 26
            tBtn.LayoutOrder = i
            tBtn.Parent = themeListFrame

            tBtn.MouseButton1Click:Connect(function()
                updateTheme(tName)
                themeListFrame.Visible = false
            end)
        end

        bThemeToggle.MouseButton1Click:Connect(function()
            playerListFrame.Visible = false
            themeListFrame.Visible = not themeListFrame.Visible
        end)

        b11.MouseButton1Click:Connect(function()
            themeListFrame.Visible = false
            playerListFrame.Visible = not playerListFrame.Visible
            if playerListFrame.Visible then refreshPlayerList() end
        end)

        b12.MouseButton1Click:Connect(function()
            flingTargetEnabled = not flingTargetEnabled
            b12.Text = flingTargetEnabled and "Fling Target: ON" or "Fling Target: OFF"
            b12.BackgroundColor3 = flingTargetEnabled and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
            updateActiveCheatsList()
        end)

        runService.Heartbeat:Connect(function()
            if flingTargetEnabled and targetPlayerName then
                local targetPlayer = game.Players:FindFirstChild(targetPlayerName)
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                        local myHrp = plr.Character.HumanoidRootPart
                        local targetHrp = targetPlayer.Character.HumanoidRootPart
                        myHrp.CFrame = targetHrp.CFrame
                        myHrp.Velocity = Vector3.new(30000, 30000, 30000)
                        myHrp.RotVelocity = Vector3.new(20000, 20000, 20000)
                    end
                end
            end
        end)

        local dragging1, dragging2, dragging3, dragging4 = false, false, false, false

        sb1.MouseButton1Down:Connect(function() dragging1 = true end)
        sb2.MouseButton1Down:Connect(function() dragging2 = true end)
        sb3.MouseButton1Down:Connect(function() dragging3 = true end)
        sb4.MouseButton1Down:Connect(function() dragging4 = true end)

        uis.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging1, dragging2, dragging3, dragging4 = false, false, false, false
            end
        end)

        uis.InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement then
                if dragging1 then
                    local rel = math.clamp((i.Position.X - sb1.AbsolutePosition.X) / sb1.AbsoluteSize.X, 0, 1)
                    sf1.Size = UDim2.new(rel, 0, 1, 0)
                    flySpeed = math.floor(10 + rel * 290)
                    sl1.Text = "Fly Speed: " .. flySpeed
                    updateActiveCheatsList()
                elseif dragging2 then
                    local rel = math.clamp((i.Position.X - sb2.AbsolutePosition.X) / sb2.AbsoluteSize.X, 0, 1)
                    sf2.Size = UDim2.new(rel, 0, 1, 0)
                    walkSpeedVal = math.floor(16 + rel * 134)
                    sl2.Text = "Walk Speed: " .. walkSpeedVal
                    updateActiveCheatsList()
                elseif dragging3 then
                    local rel = math.clamp((i.Position.X - sb3.AbsolutePosition.X) / sb3.AbsoluteSize.X, 0, 1)
                    sf3.Size = UDim2.new(rel, 0, 1, 0)
                    spinSpeedVal = math.floor(10 + rel * 190)
                    sl3.Text = "Spin Speed: " .. spinSpeedVal
                    updateActiveCheatsList()
                elseif dragging4 then
                    local rel = math.clamp((i.Position.X - sb4.AbsolutePosition.X) / sb4.AbsoluteSize.X, 0, 1)
                    sf4.Size = UDim2.new(rel, 0, 1, 0)
                    farmSpeed = math.floor(5 + rel * 95)
                    sl4.Text = "Farm Speed: " .. farmSpeed
                end
            end
        end)

        uis.InputBegan:Connect(function(i, gp)
            if gp then return end
            if i.KeyCode == Enum.KeyCode.P then
                mainFrame.Visible = not mainFrame.Visible
                cheatsPanel.Visible = mainFrame.Visible
            elseif i.KeyCode == Enum.KeyCode.LeftAlt or i.KeyCode == Enum.KeyCode.RightAlt then
                if altQuitEnabled then pcall(function() game:Shutdown() end) end
            end
        end)

        b16.MouseButton1Click:Connect(function()
            fullbrightEnabled = not fullbrightEnabled
            b16.Text = fullbrightEnabled and "Fullbright: ON" or "Fullbright: OFF"
            b16.BackgroundColor3 = fullbrightEnabled and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
            updateActiveCheatsList()
        end)

        runService.RenderStepped:Connect(function()
            if fullbrightEnabled then
                lighting.Brightness = 2
                lighting.ClockTime = 14
                lighting.GlobalShadows = false
                lighting.FogEnd = 999999
            else
                lighting.GlobalShadows = true
            end
        end)

        b15.MouseButton1Click:Connect(function()
            antiAfk = not antiAfk
            b15.Text = antiAfk and "Anti-AFK: ON" or "Anti-AFK: OFF"
            b15.BackgroundColor3 = antiAfk and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
            updateActiveCheatsList()
        end)

        plr.Idled:Connect(function()
            if antiAfk then
                pcall(function()
                    vu:CaptureController()
                    vu:ClickButton2(Vector2.new())
                end)
            end
        end)

        b14.MouseButton1Click:Connect(function()
            antiFling = not antiFling
            b14.Text = antiFling and "Anti-Fling: ON" or "Anti-Fling: OFF"
            b14.BackgroundColor3 = antiFling and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
            updateActiveCheatsList()
        end)

        runService.Stepped:Connect(function()
            if antiFling and plr.Character then
                for _, player in pairs(game.Players:GetPlayers()) do
                    if player ~= plr and player.Character then
                        for _, part in pairs(player.Character:GetDescendants()) do
                            if part:IsA("BasePart") then part.CanCollide = false end
                        end
                    end
                end
                if not flying and not flingTargetEnabled then
                    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        if hrp.Velocity.Magnitude > 100 then hrp.Velocity = Vector3.new(0, 0, 0) end
                        if hrp.RotVelocity.Magnitude > 100 then hrp.RotVelocity = Vector3.new(0, 0, 0) end
                    end
                end
            end
        end)

        b13.MouseButton1Click:Connect(function()
            autoFarmCoins = not autoFarmCoins
            b13.Text = autoFarmCoins and "Auto Farm Coins: ON" or "Auto Farm Coins: OFF"
            b13.BackgroundColor3 = autoFarmCoins and themes[currentTheme].Primary or themes[currentTheme].ButtonBg
            updateActiveCheatsList()
            if not autoFarmCoins then
                if currentTween then currentTween:Cancel() currentTween = nil end
                if plr.Character and plr.Character:FindFirstChild("Humanoid") then
                    plr.Character.Humanoid.PlatformStand = false
                end
            end
        end)

        task.spawn(function()
            while true do
                task.wait(0.05)
                if autoFarmCoins and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = plr.Character.HumanoidRootPart
                    local hum = plr.Character:FindFirstChild("Humanoid")
                    local nearestCoin = nil
                    local shortestDistance = math.huge
                    
                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("BasePart") and (v.Name == "Coin_Server" or v.Name == "Coin" or v.Name:lower():find("coin")) then
                            if v.Transparency < 1 and v.Parent then
                                local dist = (hrp.Position - v.Position).Magnitude
                                if dist < shortestDistance then
                                    shortestDistance = dist
                                    nearestCoin = v
                                end
                            end
                        end
                    end
                    
                    if nearestCoin and autoFarmCoins then
                        if hum then hum.PlatformStand = true end
                        for _, part in pairs(plr.Character:GetDescendants()) do
                            if part:IsA("BasePart") then part.CanCollide = false end
                        end
                        if currentTween then currentTween:Cancel() end
                        local info = TweenInfo.new(shortestDistance / (farmSpeed * 10), Enum.EasingStyle.Linear)
                        currentTween = tweenService:Create(hrp, info, {CFrame = nearestCoin.CFrame + Vector3.new(0, 2, 0)})
                        currentTween:Play()
                    end
                end
            end
        end)
    end)
end

