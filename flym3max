        return gethui()
    elseif syn and syn.protect_gui then
        local g = Instance.new("Folder")
        syn.protect_gui(g)
        return g
    end
    local success, _ = pcall(function() return game:GetService("CoreGui").Name end)
    if success then
        return game:GetService("CoreGui")
    end
    return plr:WaitForChild("PlayerGui")
end

