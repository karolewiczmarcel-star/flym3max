-- Fly + Noclip - przesuwalne GUI + suwak
local plr = game.Players.LocalPlayer
local cam = workspace.CurrentCamera

local flying = false
local noclip = false
local speed = 60
local fly = nil

-- GUI
local g = Instance.new("ScreenGui", game.CoreGui)
g.Name = "FlyGui"

local f = Instance.new("Frame", g)
f.Size = UDim2.new(0, 180, 0, 170)
f.Position = UDim2.new(0, 20, 0, 200)
f.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
f.BorderSizePixel = 0
f.Visible = false

-- Przyciski
local b1 = Instance.new("TextButton", f)
b1.Size = UDim2.new(0.8, 0, 0, 35)
b1.Position = UDim2.new(0.1, 0, 0, 10)
b1.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
b1.TextColor3 = Color3.fromRGB(255, 255, 255)
b1.Font = Enum.Font.Gotham
b1.TextSize = 15
b1.Text = "Fly: OFF"

local b2 = Instance.new("TextButton", f)
b2.Size = UDim2.new(0.8, 0, 0, 35)
b2.Position = UDim2.new(0.1, 0, 0, 50)
b2.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
b2.TextColor3 = Color3.fromRGB(255, 255, 255)
b2.Font = Enum.Font.Gotham
b2.TextSize = 15
b2.Text = "Noclip: OFF"

-- Suwak
local sl = Instance.new("TextLabel", f)
sl.Size = UDim2.new(0.8, 0, 0, 20)
sl.Position = UDim2.new(0.1, 0, 0, 95)
sl.BackgroundTransparency = 1
sl.TextColor3 = Color3.fromRGB(200, 200, 200)
sl.Font = Enum.Font.Gotham
sl.TextSize = 14
sl.Text = "Speed: 60"

local sb = Instance.new("Frame", f)
sb.Size = UDim2.new(0.8, 0, 0, 12)
sb.Position = UDim2.new(0.1, 0, 0, 125)
sb.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
sb.BorderSizePixel = 0

local sf = Instance.new("Frame", sb)
sf.Size = UDim2.new(0.18, 0, 1, 0)
sf.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
sf.BorderSizePixel = 0

------------------------------------------------------------
-- 🖱️ PRZESUWANIE GUI (nie działa na suwak/przyciski)
------------------------------------------------------------
local draggingGui = false
local dragStart, startPos

local uis = game:GetService("UserInputService")

f.InputBegan:Connect(function(i)
    if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    -- Sprawdź czy klik nie jest na suwaku lub przycisku
    local mouse = uis:GetMouseLocation()
    if mouse.X >= sb.AbsolutePosition.X 
    and mouse.X <= sb.AbsolutePosition.X + sb.AbsoluteSize.X
    and mouse.Y >= sb.AbsolutePosition.Y 
    and mouse.Y <= sb.AbsolutePosition.Y + sb.AbsoluteSize.Y then
        return -- klik na suwak - nie ruszaj GUI
    end
    draggingGui = true
    dragStart = i.Position
    startPos = f.Position
end)

f.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingGui = false
    end
end)

uis.InputChanged:Connect(function(i)
    if draggingGui and i.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = i.Position - dragStart
        f.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

------------------------------------------------------------
-- ⌨️ P - pokaż/ukryj
------------------------------------------------------------
uis.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.P then
        f.Visible = not f.Visible
    end
end)

------------------------------------------------------------
-- 🎚️ SUWAK (nie przesuwa GUI)
------------------------------------------------------------
local dragSlider = false

sb.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragSlider = true
    end
end)
sb.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragSlider = false
    end
end)
uis.InputChanged:Connect(function(i)
    if dragSlider and i.UserInputType == Enum.UserInputType.MouseMovement then
        local r = math.clamp((i.Position.X - sb.AbsolutePosition.X) / sb.AbsoluteSize.X, 0, 1)
        sf.Size = UDim2.new(r, 0, 1, 0)
        speed = math.floor(10 + r * 290)
        sl.Text = "Speed: " .. speed
    end
end)

------------------------------------------------------------
-- 🛩️ FLY
------------------------------------------------------------
b1.MouseButton1Click:Connect(function()
    if flying then
        flying = false
        b1.Text = "Fly: OFF"
        b1.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        if fly then fly:Destroy() end
        fly = nil
        if plr.Character and plr.Character:FindFirstChild("Humanoid") then
            plr.Character.Humanoid.PlatformStand = false
        end
    else
        if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then return end
        flying = true
        b1.Text = "Fly: ON"
        b1.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
        plr.Character.Humanoid.PlatformStand = true
        fly = Instance.new("BodyVelocity")
        fly.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        fly.Velocity = Vector3.new(0, 0, 0)
        fly.Parent = plr.Character.HumanoidRootPart
    end
end)

------------------------------------------------------------
-- ⚡ NOCLIP
------------------------------------------------------------
b2.MouseButton1Click:Connect(function()
    noclip = not noclip
    if noclip then
        b2.Text = "Noclip: ON"
        b2.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        b2.Text = "Noclip: OFF"
        b2.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end)

------------------------------------------------------------
-- 🔄 RESPAWN
------------------------------------------------------------
plr.CharacterAdded:Connect(function()
    if flying then
        flying = false
        b1.Text = "Fly: OFF"
        b1.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        fly = nil
    end
    if noclip then
        noclip = false
        b2.Text = "Noclip: OFF"
        b2.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end)

------------------------------------------------------------
-- 🎮 PĘTLE
------------------------------------------------------------
game:GetService("RunService").Stepped:Connect(function()
    if noclip and plr.Character then
        for _, v in pairs(plr.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)

game:GetService("RunService").RenderStepped:Connect(function()
    if not flying or not fly then return end
    if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = plr.Character.HumanoidRootPart
    hrp.CFrame = CFrame.new(hrp.Position) * (cam.CFrame - cam.CFrame.Position)
    
    local d = Vector3.new(0, 0, 0)
    if uis:IsKeyDown(Enum.KeyCode.W) then d = d + cam.CFrame.LookVector end
    if uis:IsKeyDown(Enum.KeyCode.S) then d = d - cam.CFrame.LookVector end
    if uis:IsKeyDown(Enum.KeyCode.A) then d = d - cam.CFrame.RightVector end
    if uis:IsKeyDown(Enum.KeyCode.D) then d = d + cam.CFrame.RightVector end
    if uis:IsKeyDown(Enum.KeyCode.Space) then d = d + Vector3.new(0, 1, 0) end
    if uis:IsKeyDown(Enum.KeyCode.LeftControl) then d = d - Vector3.new(0, 1, 0) end
    if d.Magnitude > 0 then d = d.Unit end
    fly.Velocity = d * speed
end)

print("OK - P otwiera GUI, kliknij tlo aby przesuwac")
