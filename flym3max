-- Wklej do StarterPlayerScripts jako LocalScript
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")
local camera = workspace.CurrentCamera

local flying = false
local noclip = false
local flySpeed = 60
local bodyVelocity

-- Usuń stare GUI żeby się nie nakładały
for _, gui in pairs(playerGui:GetChildren()) do
    if gui:IsA("ScreenGui") then gui:Destroy() end
end

-- Tworzenie GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FlyNoclipGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 150)
frame.Position = UDim2.new(0, 20, 0, 200)
frame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
frame.BorderSizePixel = 0
frame.Visible = false
frame.Parent = screenGui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

-- Przycisk Fly
local flyButton = Instance.new("TextButton")
flyButton.Size = UDim2.new(0.8, 0, 0, 40)
flyButton.Position = UDim2.new(0.1, 0, 0, 15)
flyButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
flyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
flyButton.Font = Enum.Font.Gotham
flyButton.TextSize = 16
flyButton.Text = "Fly: OFF"
flyButton.Parent = frame
Instance.new("UICorner", flyButton).CornerRadius = UDim.new(0, 6)

-- Przycisk Noclip
local noclipButton = Instance.new("TextButton")
noclipButton.Size = UDim2.new(0.8, 0, 0, 40)
noclipButton.Position = UDim2.new(0.1, 0, 0, 65)
noclipButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
noclipButton.TextColor3 = Color3.fromRGB(255, 255, 255)
noclipButton.Font = Enum.Font.Gotham
noclipButton.TextSize = 16
noclipButton.Text = "Noclip: OFF"
noclipButton.Parent = frame
Instance.new("UICorner", noclipButton).CornerRadius = UDim.new(0, 6)

-- Etykieta prędkości (kliknij aby zmienić)
local speedLabel = Instance.new("TextButton")
speedLabel.Size = UDim2.new(0.8, 0, 0, 30)
speedLabel.Position = UDim2.new(0.1, 0, 0, 115)
speedLabel.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
speedLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
speedLabel.Font = Enum.Font.Gotham
speedLabel.TextSize = 14
speedLabel.Text = "Speed: 60"
speedLabel.Parent = frame
Instance.new("UICorner", speedLabel).CornerRadius = UDim.new(0, 6)

-- Pokaż/ukryj GUI klawiszem P
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.P then
        frame.Visible = not frame.Visible
    end
end)

-- Funkcja startu lotu
local function startFly()
    if flying then return end
    flying = true
    humanoid.PlatformStand = true
    flyButton.Text = "Fly: ON"
    flyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    
    if bodyVelocity then bodyVelocity:Destroy() end
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.P = 1250
    bodyVelocity.Parent = rootPart
end

-- Funkcja zatrzymania lotu
local function stopFly()
    if not flying then return end
    flying = false
    humanoid.PlatformStand = false
    flyButton.Text = "Fly: OFF"
    flyButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    
    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
end

-- Kliknięcie przycisku Fly
flyButton.MouseButton1Click:Connect(function()
    if flying then stopFly() else startFly() end
end)

-- Kliknięcie przycisku Noclip
noclipButton.MouseButton1Click:Connect(function()
    noclip = not noclip
    if noclip then
        noclipButton.Text = "Noclip: ON"
        noclipButton.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
    else
        noclipButton.Text = "Noclip: OFF"
        noclipButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

-- Zmiana prędkości (cyklicznie 30, 60, 100, 150, 200)
local speeds = {30, 60, 100, 150, 200}
local speedIndex = 2
speedLabel.MouseButton1Click:Connect(function()
    speedIndex = speedIndex + 1
    if speedIndex > #speeds then speedIndex = 1 end
    flySpeed = speeds[speedIndex]
    speedLabel.Text = "Speed: " .. flySpeed
end)

-- Respawn - reset
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    rootPart = newChar:WaitForChild("HumanoidRootPart")
    if flying then
        flying = false
        flyButton.Text = "Fly: OFF"
        flyButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        bodyVelocity = nil
    end
    noclip = false
    noclipButton.Text = "Noclip: OFF"
    noclipButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
end)

-- Noclip - wyłączanie kolizji
RunService.Stepped:Connect(function()
    if noclip and character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Ruch podczas lotu
RunService.RenderStepped:Connect(function()
    if not flying then return end
    
    -- Postać obraca się jak kamera
    rootPart.CFrame = CFrame.new(rootPart.Position) * (camera.CFrame - camera.CFrame.Position)
    
    local moveDirection = Vector3.new(0, 0, 0)
    
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
        moveDirection = moveDirection + camera.CFrame.LookVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
        moveDirection = moveDirection - camera.CFrame.LookVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
        moveDirection = moveDirection - camera.CFrame.RightVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
        moveDirection = moveDirection + camera.CFrame.RightVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        moveDirection = moveDirection + Vector3.new(0, 1, 0)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        moveDirection = moveDirection - Vector3.new(0, 1, 0)
    end
    
    if moveDirection.Magnitude > 0 then
        moveDirection = moveDirection.Unit
    end
    
    bodyVelocity.Velocity = moveDirection * flySpeed
end)
