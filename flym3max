local function getRole(player)
    if not player.Character then return "Innocent" end
    if not player:FindFirstChild("Backpack") then return "Innocent" end
    
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            local n = item.Name:lower()
            if n:find("knife") or n:find("blade") or n:find("nóż") then
                return "Murderer"
            elseif n:find("gun") or n:find("revolver") or n:find("pistol") or n:find("rifle") then
                return "Sheriff"
            end
        end
    end
    for _, item in pairs(player.Character:GetChildren()) do
        if item:IsA("Tool") then
            local n = item.Name:lower()
            if n:find("knife") or n:find("blade") or n:find("nóż") then
                return "Murderer"
            elseif n:find("gun") or n:find("revolver") or n:find("pistol") or n:find("rifle") then
                return "Sheriff"
            end
        end
    end
    return "Innocent"
end

local function getRoleColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then return Color3.fromRGB(0, 150, 255)
    else return Color3.fromRGB(200, 200, 200) end
end

local function clearESP()
    for _, player in pairs(game.Players:GetPlayers()) do
        if player ~= plr and player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                local bb = head:FindFirstChild("ESPLabel")
                if bb then bb:Destroy() end
            end
            for _, part in pairs(player.Character:GetChildren()) do
                if part:IsA("Highlight") and part.Name == "ESPHighlight" then
                    part:Destroy()
                end
            end
        end
    end
end

