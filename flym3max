-- FUNKCJA ROZPOZNAWANIA RÓL
------------------------------------------------------------
local function getRole(player)
    if not player.Character then return "Innocent" end
    local function checkContainer(c)
        if not c then return nil end
        for _, item in pairs(c:GetChildren()) do
            if item:IsA("Tool") then
                local n = item.Name:lower()
                if n:find("knife") or n:find("blade") or n:find("nóż") then return "Murderer"
                elseif n:find("gun") or n:find("revolver") or n:find("pistol") then return "Sheriff" end
            end
        end
        return nil
    end
    return checkContainer(player:FindFirstChild("Backpack")) or checkContainer(player.Character) or "Innocent"
end

