------------------------------------------------------------
-- 🖱️ SLIDER LOGIC
------------------------------------------------------------
local dragging = false
sliderBack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
    end
end)
sliderBack.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local absPos = sliderBack.AbsolutePosition.X
        local absSize = sliderBack.AbsoluteSize.X
        local mouseX = input.Position.X
        local ratio = math.clamp((mouseX - absPos) / absSize, 0, 1)
        sliderFill.Size = UDim2.new(ratio, 0, 1, 0)
        flySpeed = math.floor(20 + ratio * 180)
        speedLabel.Text = "⚡ Speed: " .. flySpeed
    end
end)

------------------------------------------------------------
-- 🛩️ FLY LOGIC
------------------------------------------------------------
local function startFlying()
    if flying then return end
    flying = true
    humanoid.PlatformStand = true
    flyButton.Text = "🔥 Fly: ON"
    statusLabel.Text = "✈️ Flying like a god ✈️"

    if bodyVelocity then bodyVelocity:Destroy() end
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.P = 1250
    bodyVelocity.Parent = rootPart
end

local function stopFlying()
    if not flying then return end
    flying = false
    humanoid.PlatformStand = false
    flyButton.Text = "🔥 Fly: OFF"
    if not noclip then
        statusLabel.Text = "💀 Ready to destroy 💀"
    else
        statusLabel.Text = "⚡ Noclip active ⚡"
    end
    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
end

flyButton.MouseButton1Click:Connect(function()
    if flying then stopFlying() else startFlying() end
end)

------------------------------------------------------------
-- 🚪 NOCLIP LOGIC
------------------------------------------------------------
local function setNoclip(state)
    noclip = state
    if noclip then
        noclipButton.Text = "⚡ Noclip: ON"
        statusLabel.Text = "⚡ Noclip active ⚡"
    else
        noclipButton.Text = "⚡ Noclip: OFF"
        if flying then
            statusLabel.Text = "✈️ Flying like a god ✈️"
        else
            statusLabel.Text = "💀 Ready to destroy 💀"
        end
    end
end

noclipButton.MouseButton1Click:Connect(function()
    setNoclip(not noclip)
end)

------------------------------------------------------------
-- ⌨️ TOGGLE GUI
------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.P then
        frame.Visible = not frame.Visible
    end
end)

------------------------------------------------------------
-- 🔄 RESPAWN
------------------------------------------------------------
player.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter
    humanoid = newCharacter:WaitForChild("Humanoid")
    rootPart = newCharacter:WaitForChild("HumanoidRootPart")
    if flying then
        flying = false
        flyButton.Text = "🔥 Fly: OFF"
        bodyVelocity = nil
    end
    if noclip then setNoclip(false) end
end)

------------------------------------------------------------
-- 🎮 MOVEMENT + NOCLIP
------------------------------------------------------------
RunService.Stepped:Connect(function()
    if noclip and character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if not flying then return end
    rootPart.CFrame = CFrame.new(rootPart.Position) * (camera.CFrame - camera.CFrame.Position)

    local moveDirection = Vector3.new(0, 0, 0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
        moveDirection = moveDirection + camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
        moveDirection = moveDirection - camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
        moveDirection = moveDirection - camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
        moveDirection = moveDirection + camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        moveDirection = moveDirection + Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        moveDirection = moveDirection - Vector3.new(0, 1, 0) end

    if moveDirection.Magnitude > 0 then moveDirection = moveDirection.Unit end
    bodyVelocity.Velocity = moveDirection * flySpeed
end)
