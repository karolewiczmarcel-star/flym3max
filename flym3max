-- AUTO KILL ALL (TYLKO MORDERCA)
------------------------------------------------------------
b9.MouseButton1Click:Connect(function()
    autoKillAll = not autoKillAll
    b9.Text = autoKillAll and "Auto Kill All: ON" or "Auto Kill All: OFF"
    b9.BackgroundColor3 = autoKillAll and Color3.fromRGB(255, 120, 0) or Color3.fromRGB(25, 15, 5)
end)

task.spawn(function()
    while true do
        task.wait(0.1)
        if autoKillAll and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if getRole(plr) == "Murderer" then
                -- Wyciąganie noża z plecaka
                local knife = plr.Character:FindFirstChildOfClass("Tool")
                if not (knife and (knife.Name:lower():find("knife") or knife.Name:lower():find("blade") or knife.Name:lower():find("nóż"))) then
                    local bpKnife = plr.Backpack:FindFirstChildOfClass("Tool")
                    if bpKnife and (bpKnife.Name:lower():find("knife") or bpKnife.Name:lower():find("blade") or bpKnife.Name:lower():find("nóż")) then
                        plr.Character.Humanoid:EquipTool(bpKnife)
                        knife = bpKnife
                    end
                end

                if knife then
                    for _, target in pairs(game.Players:GetPlayers()) do
                        if not autoKillAll then break end
                        if target ~= plr and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character:FindFirstChild("Humanoid") then
                            if target.Character.Humanoid.Health > 0 then
                                local targetHrp = target.Character.HumanoidRootPart
                                local myHrp = plr.Character.HumanoidRootPart
                                
                                -- Teleportacja za plecy gracza i atak
                                myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 1)
                                knife:Activate()
                                task.wait(0.2)
                            end
                        end
                    end
                end
            end
        end
    end
end)

