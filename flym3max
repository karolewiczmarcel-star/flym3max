-- OBSŁUGA SUWAKÓW
local drag1, drag2 = false, false

sb1.InputBegan:Connect(function(i) 
    if i.UserInputType == Enum.UserInputType.MouseButton1 then drag1 = true end 
end)
sb1.InputEnded:Connect(function(i) 
    if i.UserInputType == Enum.UserInputType.MouseButton1 then drag1 = false end 
end)

sb2.InputBegan:Connect(function(i) 
    if i.UserInputType == Enum.UserInputType.MouseButton1 then drag2 = true end 
end)
sb2.InputEnded:Connect(function(i) 
    if i.UserInputType == Enum.UserInputType.MouseButton1 then drag2 = false end 
end)

uis.InputChanged:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseMovement then
        if drag1 then
            local posX = i.Position.X
            local r = math.clamp((posX - sb1.AbsolutePosition.X) / sb1.AbsoluteSize.X, 0, 1)
            sf1.Size = UDim2.new(r, 0, 1, 0)
            flySpeed = math.floor(10 + r * 290)
            sl1.Text = "Fly Speed: " .. flySpeed
        elseif drag2 then
            local posX = i.Position.X
            local r = math.clamp((posX - sb2.AbsolutePosition.X) / sb2.AbsoluteSize.X, 0, 1)
            sf2.Size = UDim2.new(r, 0, 1, 0)
            walkSpeedVal = math.floor(16 + r * 134)
            sl2.Text = "Walk Speed: " .. walkSpeedVal
        end
    end
end)

